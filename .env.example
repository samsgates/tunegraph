TUNEGRAPH_ENVIRONMENT=development
TUNEGRAPH_DATABASE_URL=sqlite+aiosqlite:///./tunegraph.db
TUNEGRAPH_SECRET_KEY=replace-with-at-least-32-random-characters
TUNEGRAPH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TUNEGRAPH_BOOTSTRAP_ADMIN_PASSWORD=
TUNEGRAPH_ARTIFACT_ROOT=./var/artifacts
TUNEGRAPH_INFERENCE_BACKEND_URL=http://vllm:8000
TUNEGRAPH_INFERENCE_BACKEND_API_KEY=
TUNEGRAPH_OPA_URL=
TUNEGRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=
TUNEGRAPH_CORS_ORIGINS=["http://localhost:3000"]
TUNEGRAPH_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# TUNEGRAPH_SIGNING_PRIVATE_KEY_PATH=./var/keys/tunegraph-private.pem
# TUNEGRAPH_SIGNING_PUBLIC_KEY_PATH=./var/keys/tunegraph-public.pem
TUNEGRAPH_ALLOW_UNSIGNED_ARTIFACTS=false
